// Quick end-to-end test on real NCBI data: downloads the small Swiss-Prot BLAST
// database (~225 MB) instead of nr, then runs TransDecoder, diamond and the plots.
// Usage: nextflow run main.nf -profile test,docker
params {
    nucleotide = "${projectDir}/Example.fasta"
    nucl_type  = 'basic'
    blast_db   = 'swissprot'
    outdir     = 'results_test'
    max_cpus   = 2
    max_memory = '6.GB'
    max_time   = '2.h'
}
