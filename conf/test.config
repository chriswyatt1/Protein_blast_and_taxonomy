// Quick end-to-end test on real NCBI data: downloads the small Swiss-Prot BLAST
// database (~225 MB download, ~1.2 GB on disk with taxonomy) instead of nr, then runs TransDecoder,
// diamond and the plots. Downloads always need --downloaddb_800GB, but with
// blast_db = 'swissprot' this one is small.
// With --search_tool blastn it downloads the small RefSeq Select RNA database (~0.1 GB) instead.
// Usage: nextflow run main.nf -profile test,docker [--search_tool blastp|blastn]
params {
    nucleotide       = "${projectDir}/Example.fasta"
    nucl_type        = 'basic'
    downloaddb_800GB = true
    blast_db         = params.search_tool == 'blastn' ? 'refseq_select_rna' : 'swissprot'
    outdir           = 'results_test'
    max_cpus         = 2
    max_memory       = '6.GB'
    max_time         = '2.h'
}
