// UCL Myriad (Sun Grid Engine), following nf-core's ucl_myriad profile.
// Myriad's -l mem is per core, so each job asks for its memory divided by its cpus.
// Standard (D-type) nodes have 36 cores and 160 GB usable memory (about 4.4 GB per core),
// and multi-core jobs can run for up to 48 hours.
params {
    max_cpus = 36
    max_memory = '160.GB'
    max_time = '48.h'
}

executor {
    name = 'sge'
    queueSize = 100           // Jobs in the queue at once
    submitRateLimit = '10/1s' // Eases pressure on the scheduler
}

process {
    executor = 'sge'
    shell = ['/bin/bash','-e']
    penv = 'smp'
    clusterOptions = { "-S /bin/bash -l mem=${task.memory.mega.intdiv(task.cpus)}M" }

    // The searches: 8 cores with 3 GB each fits Myriad's nodes, so they start sooner.
    // DIAMOND needs about 12-16 GB with its default block size.
    withName: 'DIAMOND_BLAST|NCBI_BLAST' {
        cpus = 8
        memory = 24.GB
        time = 48.h
    }
}

singularity {
    enabled = true
    autoMounts = true
    cacheDir = "${env('HOME')}/Scratch/.apptainer/pull"
    runOptions = "-B ${env('HOME')},${env('PWD')} --no-mount /scratch --writable-tmpfs"
}
