manifest {
  name = 'chriswyatt1/Protein_blast_and_taxonomy'
  description = 'Creating a blast and taxonomy script for proteins'
  contributors = [[ name: 'Chris Wyatt', contribution: ['author', 'maintainer'] ]]
  homePage = 'https://github.com/chriswyatt1/Protein_blast_and_taxonomy'
  mainScript = 'main.nf'
  version = '2.2.1'
  nextflowVersion = '!>=25.04.0'
}

// Maximum resources any single task can request (override e.g. --max_memory '16.GB')
params {
    // Defined here too (not just in main.nf) so profiles such as test can read it
    search_tool = 'diamond'
    max_cpus = 4
    max_memory = '32.GB'
    max_time = '48.h'
}

profiles {
  myriad {
    includeConfig 'conf/myriad.config'
  }
  docker {
    includeConfig 'conf/docker.config'
  }
  cscluster {
    includeConfig 'conf/cscluster.config'
  }
  apptainer {
    apptainer.enabled        = true
    // Set where singularity cached images are saved
    apptainer.cacheDir       = "apptainer/cachedir"
    // set registry to quay.io
    //apptainer.registry       = "quay.io"
    // Ensure other container engines are unset
    docker.enabled           = false
    singularity.enabled      = false
  }
  test {
    includeConfig 'conf/test.config'
  }
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'
